# Catálogo: conexão PostgreSQL do servidor (ex.: Neon).
# Copie este arquivo para .env.local e preencha localmente.
DATABASE_URL=

# Opcional: conexão direta para migrações; usa DATABASE_URL quando ausente.
DATABASE_URL_UNPOOLED=

# Monitoramento: mantenha os nomes criados pela integração Upstash na Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
CRON_SECRET=
